# Copy to .env at the repo root. Never commit .env — it is gitignored.
# Key from console.groq.com -> API Keys
GROQ_API_KEY=gsk_...

# Optional. Defaults are fine.
# LLM_PROVIDER=groq
# GROQ_MODEL=openai/gpt-oss-20b

# ---- Bedrock: only for the eval sweep and the recorded demo ------------
# Needs `uv sync --extra aws` and Bedrock model access granted for this
# model in this region (off by default). Credentials come from the usual
# boto3 chain — env vars, ~/.aws/credentials, or SSO — never from this file.
# LLM_PROVIDER=bedrock
# AWS_DEFAULT_REGION=ap-southeast-1
# BEDROCK_MODEL=   # only to override the default pinned in src/_common.py
